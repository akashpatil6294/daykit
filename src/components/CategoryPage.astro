---
import Layout from '../layouts/Layout.astro';
import AdSlot from './AdSlot.astro';
import { translations } from '../i18n';
import type { categoryKeys } from '../data/site';
interface Props {
  category: (typeof categoryKeys)[number];
}
const { category } = Astro.props;
const t = translations();
const info = t.categories[category];
---

<Layout
  title={info.title}
  description={info.description}
  breadcrumb={t.nav[category]}
>
  <section class="category-intro">
    <p class="eyebrow">{t.category.eyebrow}</p>
    <h1>{info.title}</h1>
    <p class="lead">{info.description}</p>
  </section>
  <AdSlot size="leaderboard" />
  <section class="planned-section">
    <h2>{t.category.heading}</h2>
    <p>{t.category.body}</p>
    <div class="planned-grid">
      {info.items.map((item) => (
        <article>
          <span class="badge">{t.ui.soon}</span>
          <h3>{item}</h3>
          <p>{t.category.planned}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
