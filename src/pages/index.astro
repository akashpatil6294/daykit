---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import { translations } from '../i18n';
import { imageTools } from '../i18n/image-tools';
const t = translations();
---

<Layout title={t.home.title} description={t.home.description}>
  <section class="hero">
    <div>
      <p class="eyebrow">
        <span class="tiny-dot"></span>
        {t.home.eyebrow}
      </p>
      <h1>
        {t.home.headline}
        <br />
        <span>{t.home.headlineAccent}</span>
      </h1>
      <p class="hero-intro">{t.home.intro}</p>
      <div class="hero-actions">
        <a class="button primary" href="/tools/">
          {t.home.primary}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button secondary" href="/exams/">
          {t.home.secondary}
        </a>
      </div>
      <p class="quiet hero-note">
        <span aria-hidden="true">✓</span> {t.ui.noAccount}
      </p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-orbit"></div>
      <div class="art-card art-calculator">
        <div class="calc-display">128 + 64</div>
        <div class="calc-result">
          192<span>↵</span>
        </div>
        <div class="calc-keys">
          +<span>−</span>
          <span>×</span>
          <span>=</span>
        </div>
      </div>
      <div class="art-card art-grid">
        <div class="grid-mini">
          {Array.from({ length: 9 }, (_, i) => (
            <span class:list={{ filled: [0, 4, 8].includes(i) }}>
              {[0, 4, 8].includes(i) ? '✳' : ''}
            </span>
          ))}
        </div>
      </div>
      <div class="art-spark">✳</div>
      <div class="art-file">
        <span>↗</span>
        <i></i>
        <i></i>
      </div>
      <div class="art-dots">···</div>
    </div>
  </section>
  <div class="trust-strip">
    <span>
      <b aria-hidden="true">↗</b>
      {t.ui.local}
    </span>
    <span>
      <b aria-hidden="true">◎</b>
      {t.ui.free}
    </span>
    <span>
      <b aria-hidden="true">✳</b>
      {t.ui.phase}
    </span>
  </div>
  <AdSlot size="leaderboard" />
  <section class="collections">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.home.preview}</p>
        <h2>{t.home.collection}</h2>
      </div>
      <p>{t.home.collectionIntro}</p>
    </div>
    <div class="category-grid">
      {(['tools', 'calculators', 'exams'] as const).map((key, index) => (
        <a class:list={['category-card', key]} href={`/${key}/`}>
          <div class="card-top">
            <span class="category-icon" aria-hidden="true">
              {t.categories[key].icon}
            </span>
            <span class="badge">{imageTools.available}</span>
          </div>
          <span class="card-number" aria-hidden="true">
            0{index + 1}
          </span>
          <h3>{t.categories[key].title}</h3>
          <p>{t.categories[key].short}</p>
          <div class="card-bottom">
            {t.ui.explore}
            <span aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="privacy-note">
    <span class="privacy-icon" aria-hidden="true">
      ⌑
    </span>
    <div>
      <h2>{t.home.noteTitle}</h2>
      <p>{t.home.noteBody}</p>
    </div>
    <a href="/privacy/" class="inline-link">
      {t.home.noteLink} ↗
    </a>
  </section>
</Layout>
