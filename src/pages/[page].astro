---
import Layout from '../layouts/Layout.astro';
import { legalKeys } from '../data/site';
import { translations } from '../i18n';
import { operator } from '../config/operator';
import { pdfText } from '../i18n/pdf-tools';
export function getStaticPaths() {
  return legalKeys.map((page) => ({ params: { page } }));
}
const key = Astro.params.page as (typeof legalKeys)[number];
const t = translations();
const page = t.pages[key];
const email = operator.email;
---

<Layout title={page.title} description={page.description} breadcrumb={t.nav[key]}>
  <article class="prose-page">
    <p class="eyebrow">{t.site.name}</p>
    <h1>{page.title}</h1>
    <p class="quiet">Last reviewed: <time datetime="2026-10-21">21 October 2026</time></p>
    <p class="lead">{page.intro}</p>
    {import.meta.env.PUBLIC_CONVERTER_URL && ['about','privacy'].includes(key) && <aside class="notice"><h2>{pdfText.remote}</h2><p>{pdfText.remotePrivacy}</p></aside>}
    <section>
      <h2>Operator and contact</h2>
      <p>{operator.name} · {operator.role} · {operator.country}</p>
      <a class="inline-link" data-no-translate href={`mailto:${email}`}>{email}</a>
    </section>
    {key === 'contact' && email ? (
      <section>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="inline-link" data-no-translate href={`mailto:${email}`}>
          {t.contact.configured}: {email}
        </a>
      </section>
    ) : (
      page.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </section>
      ))
    )}
    {key === 'privacy' && <section><h2>Advertising information</h2><p>Advertising is currently disabled. If Google AdSense is enabled later, third-party vendors including Google may use cookies to serve ads based on prior visits. We will update this policy and implement appropriate consent controls first.</p><p>You can manage personalization at <a class="inline-link" href="https://myadcenter.google.com/">Google Ad Settings</a> or learn about industry choices at <a class="inline-link" href="https://optout.aboutads.info/">aboutads.info</a>. See <a class="inline-link" href="https://policies.google.com/technologies/partner-sites">how Google uses information from sites and apps that use its services</a>.</p></section>}
  </article>
</Layout>
