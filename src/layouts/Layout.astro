---
import '../styles/global.css';
import { translations, defaultLocale } from '../i18n';

import { operator } from '../config/operator';
import AdIntegration from '../components/AdIntegration.astro';

interface Props {
  title: string;
  description: string;
  breadcrumb?: string;
  noindex?: boolean;
}
const { title, description, breadcrumb, noindex = false } = Astro.props;
const t = translations();
const pagePath = Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname;
const canonical = new URL(pagePath, Astro.site);
const navigation = [['/', 'Home'], ['/tools/', 'Tools'], ['/guides/', 'Guides'], ['/about/', 'About'], ['/contact/', 'Contact'], ['/privacy/', 'Privacy'], ['/terms/', 'Terms']];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t.site.name,
  url: Astro.site?.href,
  inLanguage: defaultLocale,
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical.href },
  ],
};
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <AdIntegration />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&family=JetBrains+Mono&display=swap" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {t.site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fafafa" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={`${title} | ${t.site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: t.site.name, url: Astro.site?.href, email: operator.email, founder: { '@type': 'Person', name: operator.name }, address: { '@type': 'PostalAddress', addressLocality: operator.city, addressCountry: 'IN' } })} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    {breadcrumb && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(crumbs).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.ui.skip}
    </a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <img src="/favicon.svg" width="32" height="32" alt="" />
          </span>
          {t.site.name}
          <span class="brand-dot">.</span>
        </a>
        <nav id="main-navigation" aria-label={t.ui.navigation}>
          {navigation.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a href="/about/" class="header-about">
          {t.nav.about}
          <span aria-hidden="true"> ↗</span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-navigation">Menu</button>

      </div>
    </header>
    <main id="main" class="shell" tabindex="-1">
      {breadcrumb && (
        <nav class="breadcrumbs" aria-label={t.ui.breadcrumbs}>
          <a href="/">{t.nav.home}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{breadcrumb}</span>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <a class="brand" href="/">
            {t.site.name}
            <span class="brand-dot">.</span>
          </a>
          <p>{t.site.tagline}</p>
          <p>{operator.name} · {operator.role}<br />{operator.city}, {operator.country}<br /><a href={`mailto:${operator.email}`}>{operator.email}</a></p><small>© {new Date().getFullYear()} PDF Converter</small>
        </div>
        <div>
          <nav aria-label={t.ui.footer}>
            {navigation.map(([href,label]) => <a href={href}>{label}</a>)}
            <a href="/disclaimer/">Disclaimer</a>
          </nav>

        </div>
      </div>
    </footer>

    <script>
      document.querySelector('.menu-toggle')?.addEventListener('click', (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        document.getElementById('main-navigation')?.toggleAttribute('data-open', open);
      });
    </script>
  </body>
</html>